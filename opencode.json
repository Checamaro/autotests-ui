{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "polza": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Polza AI",
      "options": {
        "baseURL": "https://polza.ai/api/v1",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "anthropic/claude-haiku-4.5": {
          "name": "anthropic/claude-haiku-4.5"
        },
        "anthropic/claude-sonnet-4.6": {
          "name": "anthropic/claude-sonnet-4.6"
        }
      }
    }
  },
  "model": "polza/anthropic/claude-sonnet-4.6",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "enabled": true
    },
    "qase": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@qase/mcp-server"
      ],
      "enabled": true,
      "environment": {
        "QASE_API_TOKEN": "{env:QASE_API_TOKEN}"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pytest*": "allow",
      "playwright show-trace*": "allow",
      "python tools/ai/summarize_allure.py*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git checkout -b*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run download*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "git push*": "ask",
      "gh pr create*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue comment*": "ask",
      "pip install*": "ask",
      "git push --force*": "deny",
      "git push origin main*": "deny",
      "rm -rf*": "deny",
      "gh repo delete*": "deny"
    }
  }
}
